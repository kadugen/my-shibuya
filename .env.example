# Copy this file to `.env` and fill in real values. Never commit `.env`.

# From your Spotify app dashboard: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret

# Must EXACTLY match a Redirect URI registered in your Spotify app settings.
# Local dev:   http://127.0.0.1:3000/callback
# Production:  https://shibuya.asherdesign.com/callback
REDIRECT_URI=http://127.0.0.1:3000/callback

# Port the server listens on (hosts usually set this automatically).
PORT=3000

# Secret used to sign session cookies. Generate a strong one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=change-me-to-a-long-random-string

# Set to "production" when deployed so cookies are marked Secure (HTTPS-only).
NODE_ENV=development

# Concerts tab — free API keys (set at least one; both = best venue coverage).
# Ticketmaster (instant): https://developer.ticketmaster.com → My Apps → Consumer Key
TICKETMASTER_API_KEY=
# SeatGeek (adds AXS / indie venues): https://seatgeek.com/account/develop → Client ID
SEATGEEK_CLIENT_ID=
# How far ahead to look, in months (default 12)
# CONCERT_MONTHS=12

# Bind address. Defaults to 127.0.0.1 locally; on Render (RENDER=true) it binds
# all interfaces automatically so Render's proxy can reach it. Rarely needed.
# HOST=127.0.0.1
